<?xml version="1.0" encoding="utf-8"?>
<!-- Al mantener pulsado el icono: acceso directo a la lectura automática. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="lectura"
        android:shortcutShortLabel="@string/atajo_lectura">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="pe.duolab.gastos.ConfigurarActivity"
            android:targetPackage="pe.duolab.gastos" />
    </shortcut>
</shortcuts>
